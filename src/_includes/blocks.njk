{# src/_includes/blocks.njk #}

{# mediaFigure: PNG/JPG/GIF or always-playing MP4 #}
{% macro mediaFigure(src, alt, poster) %}
{% set s = (src or '') | lower %}
{% if 'mp4' in s %}
<video autoplay muted loop playsinline preload="auto" {% if poster %}poster="{{ poster }}" {% endif %}
  class="media-fill">
  <source src="{{ src }}" type="video/mp4">
</video>
{% else %}
<img src="{{ src }}" alt="{{ alt or '' }}" class="media-fill" />
{% endif %}
{% endmacro %}



{% macro Intro(data) %}
<section class="project-intro content-section">
  <div class="project-intro__layout">
    <div class="project-intro__content">
      <h1 class="project-title">{{ data.title }}</h1>
      {% if data.summary %}<p class="project-summary">{{ data.summary | safe}}</p>{% endif
      %}

      {% if data.chips %}
      <div class="chip-list">
        {% for c in data.chips %}
        <span class="chip">{{ c }}</span>
        {% endfor %}
      </div>
      {% endif %}

      {% if data.actions %}
      <div class="action-list">
        {% for a in data.actions %}
        <a href="{{ a.href }}" target="_blank" rel="noopener"
          class="button {% if a.primary %}button--primary{% else %}button--secondary{% endif %}">

          {# optional icon by file path #}
          {% if a.icon %}
          <img src="{{ a.icon }}" alt="" aria-hidden="true" class="{{ a.icon_class or 'action-icon' }}">
          {% endif %}

          {# optional inline SVG (string) #}
          {% if a.icon_svg %}
          <span class="{{ a.icon_class or 'action-icon' }}" aria-hidden="true">
            {{ a.icon_svg | safe }}
          </span>
          {% endif %}

          {{ a.label }}
        </a>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if data.header_gif %}
    {% set s = data.header_scale | default(1) %}
    {% set w = (420 * s) | round(0, 'floor') %}

    <div class="project-intro__media-shell" style="--header-w: {{ w }}px;">
      <div class="project-intro__media-frame">
        <img src="{{ data.header_gif }}" alt="{{ data.header_alt or '' }}" class="media-fill"
          loading="lazy">
      </div>
    </div>
    {% endif %}

  </div>
</section>
{% endmacro %}

{% macro Video(data) %}
{% if data.youtube_id %}
<section class="content-section content-section--narrow">
  {% if data.heading %}<h2 class="section-title">{{ data.heading }}</h2>{% endif %}
  {% if data.text %}<p class="body-copy">{{ data.text }}</p>{% endif %}
  <div class="embed-frame">
    <iframe class="embed-frame__media" src="https://www.youtube-nocookie.com/embed/{{ data.youtube_id }}?rel=0"
      title="{{ data.title or 'Video' }}" loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen></iframe>
  </div>
</section>
{% endif %}
{% endmacro %}

{% macro TwoUp(data) %}
<section class="content-section">
  {% if data.heading %}<h2 class="section-title">{{ data.heading }}</h2>{% endif %}
  {% if data.text %}<p class="body-copy">{{ data.text | safe }}</p>{% endif %}

  <div class="media-grid">
    {% for fig in data.figures %}
    <figure class="media-card">
      <img src="{{ fig.src }}" alt="{{ fig.alt or '' }}" class="media-card__image" loading="lazy">
      {% if fig.caption %}<figcaption class="media-card__caption">{{ fig.caption | safe }}
      </figcaption>{% endif %}
    </figure>
    {% endfor %}
  </div>
</section>
{% endmacro %}

{# Source code card ------------------------------------ #}
{% macro SourceCard(data) %}
<section class="content-section source-section">
  <aside class="source-section__aside">
    <h2 class="section-title">{{ data.heading or "Source Code" }}</h2>
    <div class="source-card">
      <div class="source-card__header">
        <div class="source-card__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.11.8-.25.8-.57v-2.2c-3.26.71-3.95-1.4-3.95-1.4-.53-1.33-1.3-1.68-1.3-1.68-1.06-.74.08-.72.08-.72 1.17.08 1.79 1.21 1.79 1.21 1.04 1.78 2.74 1.26 3.4.96.11-.76.41-1.26.75-1.55-2.6-.3-5.34-1.3-5.34-5.82 0-1.29.46-2.34 1.21-3.17-.12-.3-.52-1.52.11-3.17 0 0 .98-.31 3.2 1.21a11.1 11.1 0 0 1 5.82 0c2.22-1.52 3.2-1.21 3.2-1.21.63 1.65.23 2.87.12 3.17.75.83 1.21 1.88 1.21 3.17 0 4.53-2.74 5.52-5.36 5.82.42.36.8 1.07.8 2.17v3.22c0 .32.21.69.81.57A11.5 11.5 0 0 0 12 .5z" />
          </svg>
        </div>
        <div>
          <p class="source-card__provider">{{ data.provider or "GitHub" }}
          </p>
          <p class="source-card__repo">{{ data.repo }}</p>
        </div>
      </div>

      {% if data.note %}
      <p class="source-card__note">{{ data.note }}</p>
      {% endif %}

      <a href="{{ data.url }}" target="_blank" rel="noopener"
        class="button button--secondary">
        Visit repository <span aria-hidden="true"></span>
      </a>
    </div>
  </aside>
</section>
{% endmacro %}

{# Back to projects ------------------------------------ #}
{% macro BackLink(href, label) %}
<nav class="back-nav">
  <a href="{{ href | default('/#projects') }}"
    class="back-link">
    <span aria-hidden="true">←</span>
    {{ label | default('Back to projects') }}
  </a>
</nav>
{% endmacro %}

{% macro TwoUpSingle(section) %}
{% set scale = section.media_scale or 1 %}
{% set baseW = section.media_base_width or 720 %}
{% set displayW = (baseW * scale) | round(0, 'floor') %}

<section class="content-section single-media-section">
  {% if section.heading %}
  <h3 class="section-title">{{ section.heading }}</h3>
  {% endif %}

  {% if section.text %}
  <div class="body-copy single-media-section__text" style="max-width: {{ baseW }}px;">
    {{ section.text | safe }}
  </div>
  {% endif %}  
  
  <div class="single-media" style="--single-media-width: {{ displayW }}px;">
    <figure class="card media-card">
      <div class="media-card__frame">
        {{ mediaFigure(section.src, section.alt, section.poster) }}
      </div>
      {% if section.caption %}
      <figcaption class="media-card__caption">{{ section.caption }}</figcaption>
      {% endif %}
    </figure>
  </div>

</section>
{% endmacro %}
