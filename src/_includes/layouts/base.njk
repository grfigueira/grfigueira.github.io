<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title or "Guilherme Figueira — Portfolio" }}</title>

  <!-- Tailwind CDN + your exact config -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            bgLight: '#f4f8f3',
            panelLight: '#ededec',
            lineLight: '#e3e3e2',
            inkLight: '#121212',
            mutedLight: '#6b6b6b',
            bgDark: '#0b1215',
            panelDark: '#0f171f',
            lineDark: '#161616',
            inkDark: '#e7eef5',
            mutedDark: '#9aa5ae',
          },
          boxShadow: { card: '0 10px 24px rgba(0,0,0,0.10)' },
          borderRadius: { xl2: '1.25rem' },
        },
      },
    };
  </script>
</head>
<body class="min-h-screen bg-bgLight text-inkLight dark:bg-bgDark dark:text-inkDark transition-colors duration-150">

  {% block header %}{% endblock %}

  <main class="mx-auto max-w-6xl px-6">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>

  {% block after %}{% endblock %}

  <footer class="border-t border-lineLight dark:border-lineDark text-center text-xs text-mutedLight dark:text-mutedDark py-4">
    Portfolio Last Updated: 2025/10/09
  </footer>

  <script src="/script.js" defer></script>
</body>
</html>
