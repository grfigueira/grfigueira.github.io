<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/assets/icons/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com"> <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&display=swap">
  <title>{{ title or "Guilherme Figueira — Portfolio" }}</title>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% block header %}{% endblock %}

  <main id="main" class="site-main">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>

  {% block after %}{% endblock %}

  <footer class="site-footer">
    Portfolio Last Updated: 2026/07
  </footer>

  <script src="/script.js" defer></script>
</body>
</html>
