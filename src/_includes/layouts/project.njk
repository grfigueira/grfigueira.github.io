---
layout: layouts/base.njk
---
{% import "blocks.njk" as B %}

{% block header %}
<header class="site-header">
  <div class="site-header__inner site-header__inner--project">
    <a href="/#projects" class="brand-link">Guilherme Figueira</a>
  </div>
</header>
{% endblock %}

{% block content %}
{{ B.BackLink(back_href, back_label) }}
{{ B.Intro(intro) }}

{% if sections %}
{% for s in sections %}
{% if s.type == "video" %}
{{ B.Video(s) }}
{% elif s.type == "two-up" %}
{{ B.TwoUp(s) }}
{% elif s.type == "two-up-single" %}
{{ B.TwoUpSingle(s) }}
{% elif s.type == "text" %}
<section class="content-section">
  {% if s.heading %}<h2 class="section-title">{{ s.heading }}</h2>{% endif %}
  {% if s.text %}<p class="body-copy">{{ s.text | safe }}</p>{% endif %}
</section>
{% elif s.type == "source" %}
{{ B.SourceCard(s) }}
{% endif %}
{% endfor %}
{% endif %}
{% endblock %}
